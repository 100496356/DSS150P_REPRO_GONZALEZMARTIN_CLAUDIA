# Copy to .env and adjust. Never commit the real .env (it is in .gitignore).
# Host-side runs use localhost:5433 (docker compose maps the container's 5432 to 5433).
# Inside docker compose, POSTGRES_HOST=postgres and POSTGRES_PORT=5432 are set automatically.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=dss150p
POSTGRES_USER=dss150p
# Training value: replace it with your own password in .env
POSTGRES_PASSWORD=change_me

AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.11
